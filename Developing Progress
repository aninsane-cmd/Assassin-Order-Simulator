        public void AddResource(string name, int amount)
        {
            if (!inventory.ContainsKey(name)) inventory[name] = 0;
            inventory[name] += amount;
            UpdateInventoryDisplay();
        }

    Since you'll now have resources that weren't hardcoded at Start() 
