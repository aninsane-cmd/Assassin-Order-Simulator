using UnityEngine;

public class ResourceSpawner : MonoBehaviour
{
    public GameObject stickPrefab;
    public int minCount = 5;
    public int maxCount = 10;
    public Vector2 areaMin = new Vector2(-8f, -8f);
    public Vector2 areaMax = new Vector2(8f, 8f);

    void Start()
    {
        SpawnSticks();
    }

    void SpawnSticks()
    {
        int count = Random.Range(minCount, maxCount + 1); // maxCount is exclusive in Random.Range(int,int), so +1 makes it inclusive
        for (int i = 0; i < count; i++)
        {
            float x = Random.Range(areaMin.x, areaMax.x);
            float y = Random.Range(areaMin.y, areaMax.y);
            Vector3 spawnPos = new Vector3(x, y, 0f);
            Instantiate(stickPrefab, spawnPos, Quaternion.identity);
        }
    }
}

Why this works with what you already have: each spawned copy is a full instance of the StickNode prefab, meaning it carries its own ResourceNode script, Collider2D, SpriteRenderer — so gathering, depleting, and the 10-second respawn timer all work independently per-stick, automatically. Nothing about GatherInteraction.cs or ResourceNode.cs needs to change.

