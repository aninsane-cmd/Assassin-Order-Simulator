A.2.3 Write the CraftingManager
This checks the inventory against a recipe's costs, and if sufficient, deducts materials and grants the item. Create Scripts/CraftingManager.cs:
using UnityEngine;

public class CraftingManager : MonoBehaviour
{
    public static CraftingManager Instance;

    void Awake()
    {
        Instance = this;
    }

    public bool CanCraft(CraftingRecipe recipe)
    {
        foreach (var cost in recipe.costs)
        {
            int owned = GuildMaster.Instance.inventory.ContainsKey(cost.resourceName)
                ? GuildMaster.Instance.inventory[cost.resourceName]
                : 0;

            if (owned < cost.amount) return false;
        }
        return true;
    }

    public bool TryCraft(CraftingRecipe recipe)
    {
        if (!CanCraft(recipe)) return false;

        // Deduct materials
        foreach (var cost in recipe.costs)
        {
            GuildMaster.Instance.inventory[cost.resourceName] -= cost.amount;
        }

        // Grant crafted item
        GuildMaster.Instance.AddResource(recipe.itemName, 1);

        return true;
    }
}

Notice TryCraft reuses your existing AddResource — the crafted item (Torch, Knife, Axe) just drops into the same inventory dictionary as raw materials. That's deliberate: one inventory system for everything, whether it's a gathered stick or a crafted torch, keeps this from splintering into "raw resource inventory" vs "item inventory" later.

Create an empty GameObject in Hierarchy, rename it CraftingManager, attach this script to it.

