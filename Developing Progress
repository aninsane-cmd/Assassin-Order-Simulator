using UnityEngine;
using UnityEngine.UI;
using TMPro;

public class GuildManager : MonoBehaviour
{
    public TMP_Text timerText;
    public TMP_Text woodCountText;
    public Button gatherWoodButton;

    private int woodCount = 0;
    private float timeRemaining = 0f;
    private bool isGathering = false;

    void Start()
    {
        gatherWoodButton.onClick.AddListener(StartGatheringWood);
        UpdateWoodDisplay();
        timerText.text = "Ready";
    }

    void Update()
    {
        if (isGathering)
        {
            timeRemaining -= Time.deltaTime;

            if (timeRemaining <= 0)
            {
                CompleteGathering();
            }
            else
            {
                timerText.text = "Gathering... " + Mathf.CeilToInt(timeRemaining) + "s";
            }
        }
    }

    void StartGatheringWood()
    {
        if (isGathering) return;

        isGathering = true;
        timeRemaining = 15f;
        gatherWoodButton.interactable = false;
    }

    void CompleteGathering()
    {
        isGathering = false;
        woodCount += 10;
        UpdateWoodDisplay();
        timerText.text = "Ready";
        gatherWoodButton.interactable = true;
    }

    void UpdateWoodDisplay()
    {
        woodCountText.text = "Wood: " + woodCount;
    }
}

