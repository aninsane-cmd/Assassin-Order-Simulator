using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections.Generic;

public class GuildManager : MonoBehaviour
{
    public TMP_Text timerText;
    public TMP_Text inventoryText;
    public Button gatherWoodButton;
    public Button gatherStoneButton;

    private Dictionary<string, int> inventory = new Dictionary<string, int>();
    private float timeRemaining = 0f;
    private bool isGathering = false;

    void Start()
    {
        inventory["Wood"] = 0;
        inventory["Stone"] = 0;

        gatherWoodButton.onClick.AddListener(() => StartGathering("Wood", 10, 15f));
        gatherStoneButton.onClick.AddListener(() => StartGathering("Stone", 5, 20f));

        UpdateInventoryDisplay();
        timerText.text = "Ready";
    }

    void Update()
    {
        if (isGathering)
        {
            timeRemaining -= Time.deltaTime;

            if (timeRemaining <= 0)
            {
                CompleteGathering();
            }
            else
            {
                timerText.text = "Gathering... " + Mathf.CeilToInt(timeRemaining) + "s";
            }
        }
    }

    string pendingResource;
    int pendingAmount;

    void StartGathering(string resourceName, int amount, float duration)
    {
        if (isGathering) return;

        isGathering = true;
        timeRemaining = duration;
        pendingResource = resourceName;
        pendingAmount = amount;

        gatherWoodButton.interactable = false;
        gatherStoneButton.interactable = false;
    }

    void CompleteGathering()
    {
        isGathering = false;
        inventory[pendingResource] += pendingAmount;
        UpdateInventoryDisplay();
        timerText.text = "Ready";

        gatherWoodButton.interactable = true;
        gatherStoneButton.interactable = true;
    }

    void UpdateInventoryDisplay()
    {
        inventoryText.text = "Wood: " + inventory["Wood"] + "\nStone: " + inventory["Stone"];
    }
}

