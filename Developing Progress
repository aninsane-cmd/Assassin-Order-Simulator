    update UpdateInventoryDisplay() to loop the dictionary dynamically instead of hardcoding each resource line:

        void UpdateInventoryDisplay()
        {
            string display = "";
            foreach (var kvp in inventory)
            {
                display += kvp.Key + ": " + kvp.Value + "\n";
            }
            inventoryText.text = display;
        }

    A.1.3.e Detect range + interact key
    Create Scripts/GatherInteraction.cs and attach it to master:

        using UnityEngine;
        using UnityEngine.InputSystem;
        using System.Collections.Generic;
        
        public class GatherInteraction : MonoBehaviour
        {
            private List<ResourceNode> nodesInRange = new List<ResourceNode>();
        
            void Update()
            {
                if (Keyboard.current != null && Keyboard.current.eKey.wasPressedThisFrame)
                {
                    if (nodesInRange.Count > 0)
                    {
                        nodesInRange[0].Gather();
                    }
                }
            }
        
            void OnTriggerEnter2D(Collider2D other)
            {
                ResourceNode node = other.GetComponent<ResourceNode>();
                if (node != null) nodesInRange.Add(node);
            }
        
            void OnTriggerExit2D(Collider2D other)
            {
                ResourceNode node = other.GetComponent<ResourceNode>();
                if (node != null) nodesInRange.Remove(node);
            }
        }

